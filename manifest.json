{
    "manifest_version": 3,
    "name": "MyHoursToAxoSoft",
    "description": "will add today's time logs to your worklog",
    "version": "5.0.1",
    "author": "Dave",
    "action": {
        "default_popup": "popup.html",
        "default_icon": "./images/TS-badge128.png"
    },
    "options_page": "options.html",
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["*://localhost/*"],
            "js": ["content-script-dx.js"]
        },
        {
            "matches": ["*://*/*"],
            "js": ["content-script-context-menu.js"]
        },
        {
            "matches": ["https://legacy.myhours.com/*"],
            "js": ["jquery-3.3.1.min.js", "content-script.js"],
            "css": ["myhours.css"]
        },
        {
            "matches": [
                "http://despacito.spica.si/*",
                "https://ontime.spica.com:442/OnTime/*",
                "https://dev.azure.com/*"
            ],
            "js": ["jquery-3.3.1.min.js","content-script-axo.js"],
            "css": ["axo.css","devops-content-script.css"],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://dev.azure.com/*"
            ],
            "js": ["jquery-3.3.1.min.js","./content-scripts/content-script-devops.js"]
        },
        {
            "matches": [
                "https://app.myhours.com/*"
            ],
            "js": ["jquery-3.3.1.min.js","./content-scripts/content-script-mh.js"]
        }       
    ],
    "icons": {
        "16": "./images/TS-badge16.png",
        "48": "./images/TS-badge48.png",
        "128": "./images/TS-badge128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "fonts/*.ttf",
                "css/*.css",
                "webfonts/*"
            ],
            "matches": ["<all_urls>"]
        }
    ],
    "permissions": [
        "alarms",
        "storage",
        "tabs",
        "activeTab",
        "notifications",
        "webRequest",
        "contextMenus",
        "clipboardWrite",
        "scripting"
    ],
    "host_permissions": [
        "https://app.myhours.com/*",
        "https://legacy.myhours.com/*",
        "https://api.myhours.com/*",
        "https://api2.myhours.com/*",
        "https://myhoursproduction-api.azurewebsites.net/api/*",
        "https://ahdevelopment-api.azurewebsites.net/*",
        "https://allhoursproduction-api.azurewebsites.net/*",
        "https://kit.fontawesome.com/*",
        "https://dev.azure.com/*"
    ]
}
